rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns the document
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth.token.email == 'infinitefutureleadersconsultin@gmail.com';
    }

    // PROFILES COLLECTION
    // Users can only read and write their own profile
    match /profiles/{userId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }

    // APP SUBMISSIONS COLLECTION
    // Users can only read and write their own submissions
    // Admin can read all submissions
    match /appSubmissions/{submissionId} {
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow create: if isAuthenticated() &&
        request.resource.data.userId == request.auth.uid;

      allow update: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );

      allow delete: if isAuthenticated() && (
        resource.data.userId == request.auth.uid ||
        isAdmin()
      );
    }

    // NOTIFICATIONS COLLECTION
    // Only server-side admin SDK can write
    // Admin can read all notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if false; // Only server-side Admin SDK can write
    }

    // Deny all other requests by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
